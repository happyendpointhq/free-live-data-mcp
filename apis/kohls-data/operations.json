        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Search keyword for products (e.g., 'tshirt', 'jeans')",
          "example": "tshirt"
        }
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number for pagination. Defaults to 1.",
        "schema": {
          "type": "integer",
          "default": 1,
          "description": "Page number for pagination. Defaults to 1.",
          "example": 1,
          "exclusiveMinimum": 0
        }
      },
      {
        "name": "pageLimit",
        "in": "query",
        "required": false,
        "description": "Number of products per page (limit). Defaults to 120.",
        "schema": {
          "type": "integer",
          "default": 120,
          "description": "Number of products per page (limit). Defaults to 120.",
          "example": 120,
          "exclusiveMinimum": 0
        }
      },
      {
        "name": "sortID",
        "in": "query",
        "required": false,
        "description": "Sort identifier (1: Featured, 4: Price Low-High, etc.).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 1,
          "description": "Sort identifier (1: Featured, 4: Price Low-High, etc.).",
          "example": 4
        }
      },
      {
        "name": "dimensionValues",
        "in": "query",
        "required": false,
        "description": "- Comma-separated filters (e.g., 'AgeAppropriate:Adult,Color:Black')\n- Eg. For Price between **\"$10 to $25\"**, use this: `Price:%2410%20to%20%2425`\n- Find the filters `Payload -> dimensions -> dimensionValues -> ID`",
        "schema": {
          "type": "string",
          "description": "- Comma-separated filters (e.g., 'AgeAppropriate:Adult,Color:Black')\n- Eg. For Price between **\"$10 to $25\"**, use this: `Price:%2410%20to%20%2425`\n- Find the filters `Payload -> dimensions -> dimensionValues -> ID`",
          "example": "AgeAppropriate:Teens,Price:%2410%20to%20%2425"
        }
      }
