          "default": 120,
          "description": "Number of products per page (limit). Defaults to 120.",
          "example": 120,
          "exclusiveMinimum": 0
        },
        "sortID": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 1,
          "description": "Sort identifier (1: Featured, 4: Price Low-High, etc.).",
