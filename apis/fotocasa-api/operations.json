      {
        "name": "combinedLocations",
        "in": "query",
        "required": true,
        "description": "",
        "schema": {
          "type": "string",
          "description": "Get the Location from /location-suggestion endpoint.",
          "example": "724,14,28,173,0,28079,0,0,0"
        }
      },
      {
        "name": "longitude",
        "in": "query",
        "required": true,
        "description": "",
        "schema": {
          "type": "string",
